# Frontend API base URL, read at BUILD time (import.meta.env.VITE_API_URL).
# Set this to the live backend when deploying, e.g.:
# VITE_API_URL=https://leather-stylish-api.onrender.com
#
# Leave it unset (or empty) during local development — /api requests then stay
# same-origin and are forwarded to the local backend by the Vite dev proxy.
VITE_API_URL=