# Backend connection — never commit a real .env file. Copy this to .env and fill it in.
# Render injects DATABASE_URL from its dashboard automatically; you only need a local .env
# (or an exported env var) when running the backend on your own machine.
#
# Example (Supabase): postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional local-only toggle: set PG_SSL=false to talk to a Postgres without TLS.
# PG_SSL=false